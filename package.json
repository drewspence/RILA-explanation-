{
  "name": "rila-explanation-tool",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "validate:strategies": "tsx scripts/validateStrategies.ts",
    "qa:e2e": "playwright test",
